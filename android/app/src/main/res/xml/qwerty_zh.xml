<?xml version="1.0" encoding="utf-8"?>
<!--
  對齊 Gboard 注音：鍵較高、間距較鬆、底列不塞爆。
  大千：1ㄅ…0ㄢ / q…p / a…l ;ㄤ / z…m ㄝㄡㄥ / 功能列
-->
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="9.4%p"
    android:horizontalGap="1.2%p"
    android:verticalGap="10dp"
    android:keyHeight="58dp">

    <!-- 10 鍵：1–0（ㄦ 改到底列空白旁，這裡不塞 -） -->
    <Row>
        <Key android:codes="49" android:keyLabel="1" android:keyEdgeFlags="left" />
        <Key android:codes="50" android:keyLabel="2" />
        <Key android:codes="51" android:keyLabel="3" />
        <Key android:codes="52" android:keyLabel="4" />
        <Key android:codes="53" android:keyLabel="5" />
        <Key android:codes="54" android:keyLabel="6" />
        <Key android:codes="55" android:keyLabel="7" />
        <Key android:codes="56" android:keyLabel="8" />
        <Key android:codes="57" android:keyLabel="9" />
        <Key android:codes="48" android:keyLabel="0" android:keyEdgeFlags="right" />
    </Row>

    <Row>
        <Key android:codes="113" android:keyLabel="q" android:keyEdgeFlags="left" />
        <Key android:codes="119" android:keyLabel="w" />
        <Key android:codes="101" android:keyLabel="e" />
        <Key android:codes="114" android:keyLabel="r" />
        <Key android:codes="116" android:keyLabel="t" />
        <Key android:codes="121" android:keyLabel="y" />
        <Key android:codes="117" android:keyLabel="u" />
        <Key android:codes="105" android:keyLabel="i" />
        <Key android:codes="111" android:keyLabel="o" />
        <Key android:codes="112" android:keyLabel="p" android:keyEdgeFlags="right" />
    </Row>

    <!-- 9 鍵 + ㄤ：略內縮像 Gboard -->
    <Row>
        <Key android:codes="97" android:keyLabel="a" android:horizontalGap="5%p" android:keyEdgeFlags="left" android:keyWidth="9%p" />
        <Key android:codes="115" android:keyLabel="s" android:keyWidth="9%p" />
        <Key android:codes="100" android:keyLabel="d" android:keyWidth="9%p" />
        <Key android:codes="102" android:keyLabel="f" android:keyWidth="9%p" />
        <Key android:codes="103" android:keyLabel="g" android:keyWidth="9%p" />
        <Key android:codes="104" android:keyLabel="h" android:keyWidth="9%p" />
        <Key android:codes="106" android:keyLabel="j" android:keyWidth="9%p" />
        <Key android:codes="107" android:keyLabel="k" android:keyWidth="9%p" />
        <Key android:codes="108" android:keyLabel="l" android:keyWidth="9%p" />
        <Key android:codes="59" android:keyLabel=";" android:keyWidth="9%p" android:keyEdgeFlags="right" />
    </Row>

    <!-- z–m + ㄝㄡㄥ：9 鍵，左右用功能鍵撐開，不塞 12 顆 -->
    <Row>
        <Key android:codes="-2" android:keyLabel="符" android:keyWidth="12%p" android:keyEdgeFlags="left" />
        <Key android:codes="122" android:keyLabel="z" android:keyWidth="8.6%p" />
        <Key android:codes="120" android:keyLabel="x" android:keyWidth="8.6%p" />
        <Key android:codes="99" android:keyLabel="c" android:keyWidth="8.6%p" />
        <Key android:codes="118" android:keyLabel="v" android:keyWidth="8.6%p" />
        <Key android:codes="98" android:keyLabel="b" android:keyWidth="8.6%p" />
        <Key android:codes="110" android:keyLabel="n" android:keyWidth="8.6%p" />
        <Key android:codes="109" android:keyLabel="m" android:keyWidth="8.6%p" />
        <Key android:codes="44" android:keyLabel="," android:keyWidth="8.6%p" />
        <Key android:codes="46" android:keyLabel="." android:keyWidth="8.6%p" />
        <Key android:codes="47" android:keyLabel="/" android:keyWidth="8.6%p" android:keyEdgeFlags="right" />
    </Row>

    <!-- 底列疏：中 | ， | 空格 | ㄦ | ⌫ | ↵ -->
    <Row>
        <Key android:codes="-1" android:keyLabel="中" android:keyWidth="11%p" android:keyEdgeFlags="left" />
        <Key android:codes="32" android:keyLabel="空格" android:keyWidth="48%p" />
        <Key android:codes="45" android:keyLabel="-" android:keyWidth="11%p" />
        <Key android:codes="-5" android:keyLabel="⌫" android:keyWidth="14%p" android:isRepeatable="true" />
        <Key android:codes="-4" android:keyLabel="↵" android:keyWidth="12%p" android:keyEdgeFlags="right" />
    </Row>
</Keyboard>
