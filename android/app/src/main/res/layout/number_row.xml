<?xml version="1.0" encoding="utf-8"?>
<!-- 固定數字列：在候選與字母鍵盤之間，不會被裁切消失 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:background="#1c1c1c">

    <!-- ids num_0..num_9 filled in code for click; labels 數字+注音 -->
    <TextView android:id="@+id/num_1" style="@style/NumberKey" android:text="1\nㄅ" />
    <TextView android:id="@+id/num_2" style="@style/NumberKey" android:text="2\nㄉ" />
    <TextView android:id="@+id/num_3" style="@style/NumberKey" android:text="3\nˇ" />
    <TextView android:id="@+id/num_4" style="@style/NumberKey" android:text="4\nˋ" />
    <TextView android:id="@+id/num_5" style="@style/NumberKey" android:text="5\nㄓ" />
    <TextView android:id="@+id/num_6" style="@style/NumberKey" android:text="6\nˊ" />
    <TextView android:id="@+id/num_7" style="@style/NumberKey" android:text="7\n˙" />
    <TextView android:id="@+id/num_8" style="@style/NumberKey" android:text="8\nㄚ" />
    <TextView android:id="@+id/num_9" style="@style/NumberKey" android:text="9\nㄞ" />
    <TextView android:id="@+id/num_0" style="@style/NumberKey" android:text="0\nㄢ" />
</LinearLayout>
