<?xml version="1.0" encoding="utf-8"?>
<!-- 固定高度：避免有/無候選時 IME 高度變化導致上層畫面跳動 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="74dp"
    android:orientation="vertical"
    android:background="#141414"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- 黃色組字列：固定 28dp，無內容時透明空白佔位 -->
    <LinearLayout
        android:id="@+id/preedit_row"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/preedit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:textSize="16sp"
            android:textColor="#ffcc00"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/btn_clear_all"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:minWidth="28dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="✕"
            android:textSize="14sp"
            android:textColor="#ffcc00"
            android:textStyle="bold"
            android:background="@drawable/clear_btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="清空組字"
            android:visibility="invisible" />
    </LinearLayout>

    <!-- 候選列：固定 44dp -->
    <HorizontalScrollView
        android:id="@+id/candidate_scroll"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:scrollbars="none"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/candidate_row"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="8dp" />
    </HorizontalScrollView>
</LinearLayout>
