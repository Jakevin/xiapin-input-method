# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Build artifacts
build/
dist/
*.egg-info/

# Editor and system files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- Android ---
android/.gradle/
android/**/build/
android/local.properties
android/**/local.properties
android/.cxx/
android/**/.cxx/
android/captures/
android/*.iml
android/**/*.iml

# APK / native build outputs (do not publish binaries in git)
*.apk
*.ap_
*.aab
*.dex
*.so
!android/app/src/**  # sources only; .so still ignored by rule above if under build

# Release zips / local packages
*.zip
!docs/**

# Secrets / machine-specific
.env
*.keystore
*.jks
**/google-services.json
